# Models, sources and receipts are pinned by their bytes: a checkout that rewrites one invalidates the evidence on that
# platform alone, which is invisible where the model was trained. So nothing here changes its line endings on any system.
* text=auto eol=lf

*.gz binary
*.xz binary
*.zst binary
*.ksm binary
*.bin binary
*.ico binary
*.icns binary
*.png binary
*.lm binary
*.dic binary
*.aff binary
model/intent_v1/sources/COPYRIGHT.onboard-data -text whitespace=-trailing-space
model/intent_v1/sources/COPYRIGHT.hunspell -text whitespace=-trailing-space
