<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        The hardened runtime is required for notarization, and it forbids
        executable memory that carries no signature. Python's foreign-function
        layer builds its call thunks in exactly such memory: without this right
        the program does not fail, it hangs at startup while the library tries
        one temporary directory after another. Measured on macOS 13: the import
        of the spelling module never returned.
    -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
</dict>
</plist>
